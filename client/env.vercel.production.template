# Vercel → Client project → Environment Variables → Production
# Rebuild after changing (Vite bakes VITE_* at build time).

# Backend API origin (no trailing slash).
VITE_API_BASE=https://YOUR-BACKEND.vercel.app

# Optional: second origin for customer/auth calls if primary fails.
# VITE_API_FALLBACK_BASE=http://localhost:5000

# URL of the marketing landing page (used for "Volver al sitio" links).
VITE_MARKETING_SITE=https://omnira.es
