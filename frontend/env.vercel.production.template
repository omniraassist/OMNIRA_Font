# Vercel → Frontend project → Environment Variables → Production
# Rebuild frontend after changing (Vite bakes VITE_* at build time).

# Backend API origin (no trailing slash). Must match your deployed Express API.
VITE_API_BASE=https://YOUR-BACKEND.vercel.app
# Optional: second origin for customer/auth calls if primary fails (network or 5xx). Example local API:
# VITE_API_FALLBACK_BASE=http://localhost:5000
