{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/calendar/drain",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/internal/twilio/release-expired",
      "schedule": "0 2 * * *"
    }
  ]
}
