SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=your_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt
SUPABASE_PROJECT_ID=your_project_id
PORT=5000

# OpenAI — widget web (POST /api/public/chat). Solo en el backend (proyecto Vercel del API), nunca VITE_* en el frontend.
# Nombre recomendado (Vercel → Environment Variables → Production + Preview si aplica):
OPENAI_API_KEY=
# Alternativas reconocidas por el servidor:
# OPENAI_KEY=
# OPEN_AI_API_KEY=
# OPENAI_SECRET_KEY=
# CHAT_OPENAI_API_KEY=
# Valor: sk-… sin comillas. Tras guardar: Redeploy. Comprueba GET /health → openai_chat_configured true.

OPENAI_CHAT_MODEL=gpt-4o-mini

# Solo respuesta fija sin OpenAI (demos): true / 1 / yes
# OMNIRA_CHAT_STATIC_FALLBACK=false

# Opcional: prompt del sistema (máx. ~8000 caracteres)
# OMNIRA_CHAT_SYSTEM_PROMPT=

# --- Sesión cliente (JWT) — obligatorio en producción
CUSTOMER_JWT_SECRET=genera_un_secreto_largo_aleatorio

# --- Stripe (solo backend; nunca publiques sk_live en el frontend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública del sitio (sin barra final). Ej: https://tu-dominio.vercel.app
PUBLIC_APP_URL=http://localhost:5173

# Opcional: simular pago sin Stripe (solo QA; nunca true en producción)
# OMNIRA_ALLOW_SUBSCRIPTION_SIMULATE=false
