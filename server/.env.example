SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=your_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt
SUPABASE_PROJECT_ID=your_project_id
PORT=5000

# OpenAI — widget web (POST /api/public/chat). Obligatorio en el backend (Vercel del API), nunca en VITE_* del frontend.
OPENAI_API_KEY=
# Si no usas OPENAI_API_KEY, puedes probar con:
# OPENAI_KEY=

OPENAI_CHAT_MODEL=gpt-4o-mini

# Solo si quieres respuesta fija sin OpenAI (demos): true / 1 / yes
# OMNIRA_CHAT_STATIC_FALLBACK=false

# Opcional: sustituye el prompt del sistema (máx. ~8000 caracteres)
# OMNIRA_CHAT_SYSTEM_PROMPT=