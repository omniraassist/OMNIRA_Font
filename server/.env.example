SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=your_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt
# El servidor también acepta SUPABASE_SECRET_KEY si solo tienes ese nombre en Vercel (ideal: JWT service_role en SERVICE_ROLE_KEY).
SUPABASE_PROJECT_ID=your_project_id
PORT=5000

# Direct Postgres URI for node schema.js (DDL). Supabase → Settings → Database → Connection string (URI), port 5432.
# Optional SSL: PGSSL_REJECT_UNAUTHORIZED=0 if your client rejects the Supabase cert.
# DATABASE_URL=postgresql://postgres.xxx:PASSWORD@db.xxx.supabase.co:5432/postgres

# --- Supabase API (app runtime) ---

# --- Meta WhatsApp Cloud API (marketing WABA webhook en este backend) ---
# Meta Developer → Tu app → WhatsApp → Configuración → Webhook:
#   URL: https://TU-API.vercel.app/api/meta/whatsapp/webhook
#   Verify token: el mismo valor que META_WABA_VERIFY_TOKEN
# Suscripción de campos: messages (y los que use tu flujo).
META_WABA_VERIFY_TOKEN=
META_WABA_APP_SECRET=
# Token de acceso de la app / número (Graph API) para envíos opcionales desde el webhook:
# Los tokens de usuario caducan; si Graph devuelve 401, genera uno nuevo con permisos whatsapp_business_messaging.
# Prueba local: npm run test:wa-agent  (opcional: OMNIRA_WA_TEST_TO_E164=34612345678 OMNIRA_WA_TEST_BASE=http://127.0.0.1:5000)
# META_WABA_ACCESS_TOKEN=
# META_WABA_PHONE_NUMBER_ID=
# Graph API version (por defecto v21.0)
# META_WABA_GRAPH_VERSION=v21.0
# Solo local: aceptar POST sin verificar firma (nunca en producción)
# META_WABA_WEBHOOK_INSECURE_LOCAL=true
# Texto opcional: si está definido, el webhook responde con un mensaje de texto a cada inbound de usuario (pruebas).
# META_WABA_MARKETING_AUTO_REPLY=

# --- Sesión cliente (JWT) — obligatorio en producción
CUSTOMER_JWT_SECRET=genera_un_secreto_largo_aleatorio

# --- Stripe (solo backend; nunca publiques sk_live en el frontend)
STRIPE_SECRET_KEY=
# Clave publicable para Elements embebido en el panel (pk_live_… / pk_test_…)
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo desarrollo local: si WEBHOOK_SECRET está vacío, acepta JSON sin firma en /api/stripe/webhook (no funciona en Vercel).
# STRIPE_WEBHOOK_INSECURE_LOCAL=true
# Con Stripe CLI: stripe listen --forward-to http://localhost:5000/api/stripe/webhook → pega whsec_… arriba y NO uses INSECURE_LOCAL.
# URL pública del sitio (sin barra final). Ej: https://tu-dominio.vercel.app
PUBLIC_APP_URL=http://localhost:5173

# Opcional: simular pago sin Stripe (solo QA; nunca true en producción)
# OMNIRA_ALLOW_SUBSCRIPTION_SIMULATE=false

# =============================================================================
# Vercel (backend project) — pegar en Environment Variables → Production
# Plantilla completa: env.vercel.production.template
# =============================================================================
# Obligatorio: SUPABASE_*, CUSTOMER_JWT_SECRET, STRIPE_SECRET_KEY, PUBLIC_APP_URL
# Webhook firmado: STRIPE_WEBHOOK_SECRET = whsec_… del endpoint
#   https://TU-API.vercel.app/api/stripe/webhook  (eventos: checkout.session.completed, payment_intent.succeeded)
# El pago embebido confirma con POST /api/customer/stripe/payment-intent/sync (además del webhook payment_intent.succeeded).
# Nunca STRIPE_WEBHOOK_INSECURE_LOCAL en producción.
