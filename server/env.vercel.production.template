# Copy each line into Vercel → Backend project → Settings → Environment Variables → Production.
# Replace PLACEHOLDER values. Never commit real secrets to git.

# --- Your two secrets (from you) ---
# 1) Stripe Dashboard → Developers → API keys → Secret key (sk_live_…)
STRIPE_SECRET_KEY=PASTE_sk_live_HERE

# 2) Same random string you use for customer JWT (must match what you used when testing locally)
CUSTOMER_JWT_SECRET=PASTE_LONG_RANDOM_SECRET_HERE

# --- Third secret (webhook — not the same as sk_live) ---
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   URL: https://YOUR-BACKEND.vercel.app/api/stripe/webhook
#   Events: checkout.session.completed, payment_intent.succeeded
# Then "Reveal" signing secret → whsec_…
STRIPE_WEBHOOK_SECRET=PASTE_whsec_FROM_DASHBOARD_HERE

# Publishable key (pk_live_…) — embedded Stripe Elements in customer panel
STRIPE_PUBLISHABLE_KEY=PASTE_pk_live_HERE

# --- Public URL of the deployed frontend (no trailing slash) ---
# Stripe redirects here after pay: /?checkout=success&session_id=…
PUBLIC_APP_URL=https://YOUR-FRONTEND.vercel.app

# --- Supabase (same as local .env) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_service_role_jwt_HERE
SUPABASE_ANON_KEY=PASTE_anon_jwt_HERE
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_ID=your_project_ref

# --- Meta WhatsApp (Cloud API webhook on this backend) ---
# Webhook URL: https://YOUR-BACKEND.vercel.app/api/meta/whatsapp/webhook
META_WABA_VERIFY_TOKEN=
META_WABA_APP_SECRET=
# META_WABA_ACCESS_TOKEN=
# META_WABA_PHONE_NUMBER_ID=
# META_WABA_GRAPH_VERSION=v21.0
# META_WABA_MARKETING_AUTO_REPLY=

# --- Do NOT set these in production ---
# STRIPE_WEBHOOK_INSECURE_LOCAL=
# OMNIRA_ALLOW_SUBSCRIPTION_SIMULATE=
